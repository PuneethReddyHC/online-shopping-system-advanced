.PHONY: verify test lint types

# Where the application is. The specification and this kit are in `spec/`, and
# running the checks over them finds nothing to check -- which is the failure mode
# this variable exists to prevent: `make verify` passing because it looked in an
# empty room and found no problems.
CODE := code

# One command decides correctness. Named in CLAUDE.md as the definition of done.
verify: lint types test
	@echo "all checks passed"

test:
	cd $(CODE) && pytest -q

lint:
	cd $(CODE) && ruff check .

types:
	cd $(CODE) && mypy .
